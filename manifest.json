{
  "manifest_version": 3,
  "name": "BrowserGuard",
  "version": "1.6.0",
  "description": "Local ad, tracker, phishing and malicious-site protection.",
  "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"},
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "webNavigation", "declarativeNetRequest", "declarativeNetRequestFeedback", "alarms", "scripting"],
  "host_permissions": ["https://urlhaus.abuse.ch/*", "https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": {"service_worker": "src/background/service-worker.js", "type": "module"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/youtube/ad-assist.js"], "css": ["src/youtube/ad-assist.css"], "run_at": "document_start"}],
  "action": {"default_title": "BrowserGuard", "default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png"}},
  "options_page": "src/dashboard/dashboard.html",
  "declarative_net_request": {
    "rule_resources": [
      {"id": "ads", "enabled": true, "path": "rules/ads.json"},
      {"id": "trackers", "enabled": true, "path": "rules/trackers.json"}
    ]
  },
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
